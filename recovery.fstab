/system          ext4     /dev/block/bootdevice/by-name/system                             flags=display=system
/vendor          ext4     /dev/block/bootdevice/by-name/vendor                             flags=display=vendor
/cache           ext4     /dev/block/bootdevice/by-name/cache                              flags=display=cache
/data            ext4     /dev/block/bootdevice/by-name/userdata                           flags=display=data
/boot            emmc     /dev/block/bootdevice/by-name/boot                               flags=display=boot
/recovery        emmc     /dev/block/bootdevice/by-name/FOTAKernel                         flags=display=recovery
/persistent      emmc     /dev/block/bootdevice/by-name/frp                                flags=display=persistent
/dsp             ext4     /dev/block/bootdevice/by-name/dsp                                flags=display=dsp
/misc            emmc     /dev/block/bootdevice/by-name/misc                               flags=display=misc
/firmware        vfat     /dev/block/bootdevice/by-name/modem                              flags=display=firmware
/bt_firmware     vfat     /dev/block/bootdevice/by-name/bluetooth                          flags=display=bt_firmware
/persist         ext4     /dev/block/bootdevice/by-name/persist                            flags=display=persist
/qns             ext4     /dev/block/bootdevice/by-name/Qnovo                              flags=display=qns
auto             auto     /devices/soc/c0a4900.sdhci/mmc_host/mmc*                         flags=display=auto
auto             auto     /devices/soc/a800000.ssusb/a800000.dwc3/xhci-hcd.0.auto/usb*     flags=display=auto
none             swap     /dev/block/zram0                                                 flags=display=none
